{#- List of pages: section, sub-section and taxonomy term pages. ~#}
{%- extends '_default/page.html.twig' -%}

{#- all showable pages by default -#}
{%- set pages = site.pages.showable -%}
{#- in case of a list page, take its sub pages -#}
{%- if page.pages is defined -%}
  {%- set pages = page.pages -%}
{%- endif -%}
{#- in case of a paginated list page, take the paginator pages -#}
{%- if page.paginator.pages is defined -%}
  {%- set pages = page.paginator.pages -%}
{%- endif -%}

{%- block main ~%}
                  <section>
                    <h1 class="h1 font-aspekta mb-5">{{ page.title }}</h1>
                    {%- if page.content ~%}
                    <div class="content mb-8">
                      {{- page.content ~}}
                    </div>
                    {%- endif ~%}
                    {{- include('partials/filters.html.twig') ~}}
                    <div>
                      {%- for p in pages ~%}
                      {{- include('partials/post.html.twig', {p: p}) ~}}
                      {%- else ~%}
                      <p class="py-5 text-slate-500 dark:text-slate-400">{% trans %}Nothing to see here, yet.{% endtrans %}</p>
                      {%- endfor ~%}
                    </div>
                    {{- include('partials/paginator.html.twig') ~}}
                  </section>
{%- endblock main ~%}
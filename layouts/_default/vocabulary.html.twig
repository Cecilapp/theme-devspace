{#- Taxonomy page: list of terms. ~#}
{%- extends '_default/page.html.twig' -%}

{%- block main ~%}
                  <section>
                    <h1 class="h1 font-aspekta mb-5">{{ page.title }}</h1>
                    {%- if page.content ~%}
                    <div class="content mb-8">
                      {{- page.content ~}}
                    </div>
                    {%- endif ~%}
                    <ul class="flex flex-wrap gap-2">
                      {%- for term in page.terms ~%}
                      <li>
                        <a class="text-sm inline-flex items-center font-aspekta font-[650] text-sky-500 border border-slate-200 dark:border-slate-800 hover:border-sky-500 rounded-full px-4 h-8 transition-colors" href="{{ url(term.id, {language: site.language}) }}">
                          {{- term.name }} <span class="text-slate-400 dark:text-slate-500 ml-1.5">{{ term|length }}</span>
                        </a>
                      </li>
                      {%- endfor ~%}
                    </ul>
                  </section>
{%- endblock main ~%}

{#- Page footer: social links and copyright. ~#}
{%- import 'macros/icons.twig' as icons -%}
{%- set social = site.devspace.social|default({}) ~%}
            <footer class="border-t border-slate-200 dark:border-slate-800">
              <div class="py-8">
                <div class="text-center md:flex md:items-center md:justify-between">
                  {%- if social|length > 0 ~%}
                  <ul class="inline-flex mb-4 md:order-1 md:ml-4 md:mb-0 space-x-2">
                    {%- for name, href in social ~%}
                    <li>
                      <a class="flex justify-center items-center text-sky-500 hover:text-sky-600 transition duration-150 ease-in-out" href="{{ url(href) }}"{% if href starts with 'http' %} target="_blank" rel="noreferrer"{% endif %} aria-label="{{ name|capitalize }}">
                        {{- icons.social(name) -}}
                      </a>
                    </li>
                    {%- endfor ~%}
                  </ul>
                  {%- endif ~%}
                  <div class="text-sm text-slate-500 dark:text-slate-400">
                    {%- set powered_by -%}
                    <a class="hover:underline" href="{{ cecil.url }}">Cecil</a> &amp; <a class="hover:underline" href="https://cruip.com/">DevSpace</a>
                    {%- endset -%}
                    &copy; {{ 'now'|date('Y') }} {{ site.devspace.copyright|default(site.title) }} &middot; {% trans %}Powered by %powered_by%{% endtrans %}
                  </div>
                </div>
              </div>
            </footer>
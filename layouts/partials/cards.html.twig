{#-
  A grid of cards. Expects `section`:
    title: Open-Source Projects
    type: project|video  (default: project)
    cards:
      - title: Awesome Container Tinkering
        text: Solutions for running containers locally and remotely.
        url: https://example.com
        icon: images/project-icon-01.svg  (type: project)
        image: images/popular-post-01.jpg (type: video)
        badge: Open-Source
~#}
{%- import 'macros/icons.twig' as icons -%}
{%- if section.cards|default([])|length > 0 ~%}
                      <section>
                        {%- if section.title|default(false) ~%}
                        <h2 class="font-aspekta text-xl font-[650] mb-5">{{ section.title }}</h2>
                        {%- endif ~%}
                        <div class="grid sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 gap-5">
                          {%- for card in section.cards ~%}
                          {%- if section.type|default('project') == 'video' ~%}
                          <a class="relative aspect-video rounded-lg overflow-hidden bg-linear-to-tr from-slate-800 to-slate-700 odd:rotate-1 even:-rotate-1 hover:rotate-0 transition-transform duration-700 hover:duration-100 ease-in-out shadow-xl" href="{{ url(card.url|default('#')) }}">
                            {%- if card.image|default(false) ~%}
                            <img class="absolute inset-0 w-full h-full object-cover opacity-40" src="{{ url(asset(card.image)|resize(672)) }}" width="336" height="189" alt="{{ card.title|e }}">
                            {%- endif ~%}
                            <div class="h-full relative flex flex-col items-start justify-between before:mt-auto before:flex-1 p-5">
                              <div class="flex-1 flex items-center text-lg font-aspekta text-white font-[650]">{{ card.title }}</div>
                              <div class="flex-1 w-full flex justify-end items-end">
                                {{- icons.ui('play') -}}
                              </div>
                            </div>
                          </a>
                          {%- else ~%}
                          <a class="rounded-lg border border-slate-200 hover:border-slate-300 dark:border-slate-800 dark:hover:border-slate-700 dark:bg-linear-to-t dark:from-slate-800 dark:to-slate-800/30 odd:-rotate-1 even:rotate-1 hover:rotate-0 transition-transform duration-700 hover:duration-100 ease-in-out p-5 group" href="{{ url(card.url|default('#')) }}">
                            <div class="flex flex-col h-full">
                              <div class="grow">
                                <div class="flex items-center justify-between space-x-2">
                                  {%- if card.avatar|default(false) ~%}
                                  <img class="rounded-full mb-2" src="{{ url(asset(card.avatar)|resize(80)) }}" width="40" height="40" alt="{{ card.title|e }}">
                                  {%- elseif card.icon|default(false) ~%}
                                  <div class="h-10 w-10 flex items-center justify-center border border-slate-200 dark:border-slate-700 rounded-full mb-2">
                                    <img src="{{ url(asset(card.icon)) }}" width="18" height="18" alt="" aria-hidden="true">
                                  </div>
                                  {%- endif ~%}
                                  {%- if card.badge|default(false) ~%}
                                  <div class="text-xs inline-flex items-center font-medium bg-green-100 text-green-600 rounded-full text-center px-2 h-5">{{ card.badge }}</div>
                                  {%- endif ~%}
                                </div>
                                <div class="text-lg font-aspekta font-[650] mb-1">{{ card.title }}</div>
                                {%- if card.text|default(false) ~%}
                                <p class="text-sm text-slate-500 dark:text-slate-400 mb-2">{{ card.text }}</p>
                                {%- endif ~%}
                              </div>
                              <div class="text-sky-500 flex justify-end">
                                {{- icons.ui('arrow-right', 'fill-current -rotate-45 group-hover:rotate-0 transition-transform ease-out') -}}
                              </div>
                            </div>
                          </a>
                          {%- endif ~%}
                          {%- endfor ~%}
                        </div>
                      </section>
{%- endif ~%}

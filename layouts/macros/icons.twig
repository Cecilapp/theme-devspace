{#
  SVG icons used by the theme.

  Usage:
    {% import 'macros/icons.twig' as icons %}
    {{ icons.nav('home') }}
    {{ icons.social('github') }}
    {{ icons.ui('arrow-right', 'fill-current') }}
#}


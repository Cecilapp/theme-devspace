{#- Projects page (`layout: projects`): groups of cards defined in the `sections` front matter variable. ~#}
{%- extends '_default/page.html.twig' -%}

{%- block main ~%}
                  <section>
                    <h1 class="h1 font-aspekta mb-12">{{ page.title }}</h1>
                    {%- if page.content ~%}
                    <div class="content mb-10">
                      {{- page.content ~}}
                    </div>
                    {%- endif ~%}
                    <div class="space-y-10">
                      {%- for section in page.sections|default([]) ~%}
                      {{- include('partials/cards.html.twig', {section: section}) ~}}
                      {%- endfor ~%}
                    </div>
                  </section>
{%- endblock main ~%}

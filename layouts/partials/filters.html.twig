{#- Tabs to filter posts by term, from the `devspace.filters` vocabulary (e.g. `categories`). ~#}
{%- set vocabulary = site.devspace.filters|default(false) -%}
{%- if vocabulary and site.taxonomies[vocabulary] is defined and site.taxonomies[vocabulary]|length > 0 ~%}
                        <ul class="flex flex-wrap text-sm border-b border-slate-100 dark:border-slate-800">
                          {%- set active = page.type != 'term' ~%}
                          <li class="px-3 -mb-px">
                            <a class="block py-3 {% if active %}font-medium text-slate-800 dark:text-slate-100 border-b-2 border-sky-500{% else %}text-slate-500 hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300{% endif %}" href="{{ url(site.home) }}">{% trans %}All{% endtrans %}</a>
                          </li>
                          {%- for term in site.taxonomies[vocabulary] ~%}
                          {%- set active = page.type == 'term' and page.term == term.id ~%}
                          <li class="px-3 -mb-px">
                            <a class="block py-3 {% if active %}font-medium text-slate-800 dark:text-slate-100 border-b-2 border-sky-500{% else %}text-slate-500 hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300{% endif %}" href="{{ url(term.id, {language: site.language}) }}"{% if active %} aria-current="page"{% endif %}>{{ term.name }}</a>
                          </li>
                          {%- endfor ~%}
                        </ul>
{%- endif ~%}
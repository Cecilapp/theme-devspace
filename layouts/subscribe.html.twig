{#- Subscribe page (`layout: subscribe`): pitch, benefits list, subscription form and testimonials. ~#}
{%- extends '_default/page.html.twig' -%}
{%- import 'macros/icons.twig' as icons -%}

{%- set widget = page.newsletter|default(site.devspace.newsletter)|default({}) -%}

{%- block main ~%}
                  <div class="space-y-10">
                    <section>
                      <h1 class="h1 font-aspekta mb-5">{{ page.title }}</h1>
                      <div class="text-slate-500 dark:text-slate-400 space-y-8">
                        {%- if page.content ~%}
                        <div class="content text-lg">
                          {{- page.content ~}}
                        </div>
                        {%- endif ~%}
                        {%- if page.benefits|default([])|length > 0 ~%}
                        <ul class="space-y-4">
                          {%- for benefit in page.benefits ~%}
                          <li class="flex items-start">
                            {{- icons.ui('check') -}}
                            <span>{{ benefit }}</span>
                          </li>
                          {%- endfor ~%}
                        </ul>
                        {%- endif ~%}
                        <div>
                          <form{% if widget.action|default(false) %} action="{{ widget.action }}" method="{{ widget.method|default('post') }}"{% endif %}>
                            <div class="flex flex-col md:flex-row justify-center max-w-xs mx-auto md:max-w-md md:mx-0">
                              <label class="sr-only" for="subscribe">{% trans %}Your email…{% endtrans %}</label>
                              <input id="subscribe" name="{{ widget.param|default('email') }}" type="email" class="form-input w-full mb-2 md:mb-0 md:mr-2" placeholder="{% trans %}Your email…{% endtrans %}" required>
                              <button class="btn text-white bg-sky-500 hover:bg-sky-600" type="submit">{{ widget.button|default('Subscribe') }}</button>
                            </div>
                          </form>
                          {%- if widget.avatars|default([])|length > 0 or widget.text|default(false) ~%}
                          <div class="flex items-center mt-5">
                            {%- if widget.avatars|default([])|length > 0 ~%}
                            <div class="inline-flex -space-x-3 -ml-0.5">
                              {%- for avatar in widget.avatars ~%}
                              {{- include('partials/image.html.twig', {src: avatar, attributes: {class: 'rounded-full border-2 border-white dark:border-slate-800 box-content', width: 24, height: 24, alt: '', 'aria-hidden': 'true', loading: 'lazy', decoding: 'async'}}) -}}
                              {%- endfor ~%}
                            </div>
                            {%- endif ~%}
                            {%- if widget.text|default(false) ~%}
                            <div class="text-sm text-slate-500 ml-3">{{ widget.text }}</div>
                            {%- endif ~%}
                          </div>
                          {%- endif ~%}
                        </div>
                      </div>
                    </section>
                    {%- for section in page.sections|default([]) ~%}
                    {{- include('partials/cards.html.twig', {section: section}) ~}}
                    {%- endfor ~%}
                  </div>
{%- endblock main ~%}


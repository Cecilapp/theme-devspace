{#- Popular posts: pages listed in `popular.pages`, or pages with `popular: true` in their front matter. ~#}
{%- set widget = page.popular ?? site.devspace.popular ?? {} -%}
{%- if widget.pages|default([])|length > 0 -%}
  {%- set pages = site.pages.showable|filter(p => p.id in widget.pages) -%}
{%- else -%}
  {%- set pages = site.pages.showable|filter(p => p.popular|default(false)) -%}
{%- endif -%}
{%- if pages|length > 0 ~%}
                  <div class="rounded-lg border border-slate-200 dark:border-slate-800 dark:bg-linear-to-t dark:from-slate-800 dark:to-slate-800/30 odd:rotate-1 even:-rotate-1 p-5">
                    <div class="font-aspekta font-[650] mb-3">{{ widget.title|default('Popular Posts') }}</div>
                    <ul class="space-y-3">
                      {%- for p in pages|slice(0, widget.max|default(5)) ~%}
                      <li class="inline-flex">
                        <span class="text-sky-500 mr-2">—</span> <a class="font-aspekta font-[650] text-sm inline-flex relative hover:text-sky-500 duration-150 ease-out before:scale-x-0 before:origin-center before:absolute before:inset-0 before:bg-sky-200 dark:before:bg-sky-500 before:opacity-30 before:-z-10 before:translate-y-1/4 before:-rotate-2 hover:before:scale-100 before:duration-150 before:ease-in-out" href="{{ url(p) }}">{{ p.title }}</a>
                      </li>
                      {%- endfor ~%}
                    </ul>
                  </div>
{%- endif ~%}
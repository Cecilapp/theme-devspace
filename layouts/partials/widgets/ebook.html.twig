{#- E-book teaser. ~#}
{%- set widget = page.ebook ?? site.devspace.ebook ?? {} -%}
{%- if widget.image|default(false) ~%}
                  <div class="rounded-lg border border-slate-200 dark:border-slate-800 dark:bg-linear-to-t dark:from-slate-800 dark:to-slate-800/30 odd:rotate-1 even:-rotate-1 p-5">
                    <div class="font-aspekta font-[650] text-center mb-3">{{ widget.title|default('Free E-Book') }}</div>
                    <div class="text-center">
                      {%- if widget.url|default(false) %}<a href="{{ url(widget.url) }}">{% endif -%}
                      <img class="inline-flex rounded-lg shadow-lg rotate-3" src="{{ url(asset(widget.image)|resize(296)) }}" width="148" alt="{{ widget.title|default('Free E-Book')|e }}">
                      {%- if widget.url|default(false) %}</a>{% endif -%}
                    </div>
                  </div>
{%- endif ~%}
